<mujoco model="quad_scene">
  <!-- World wrapper around quad.xml: ground plane, lighting, camera - for
       interactive viewing only. Headless excitation trials (Stage A data
       collection) load quad.xml directly and never touch this file, so
       visualization additions here can never leak into identification
       data. -->
  <include file="quad.xml"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.5 0.5 0.5"/>
    <global azimuth="120" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.6 0.8" rgb2="0.05 0.08 0.15" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.32 0.4" rgb2="0.15 0.2 0.28"
              markrgb="0.7 0.75 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.06"/>
    <material name="prop_mat" rgba="0.5 0.55 0.6 1" specular="0.2" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- Sun-like key light (angled, casts shadows) plus the original
         overhead fill light - two lights read much better than one flat
         overhead source, which was washing out the drone's shading. -->
    <light name="sun" pos="4 -4 6" dir="-0.5 0.5 -0.7" diffuse="0.9 0.9 0.85" specular="0.3 0.3 0.3" castshadow="true"/>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" castshadow="false"/>
    <geom name="floor" type="plane" size="10 10 0.1" material="groundplane" contype="0" conaffinity="0"/>

    <!-- Simple reference props (visualization-only: contype/conaffinity=0,
         no mass, no joints - cannot affect physics or identification data)
         so the flight envelope has spatial scale/depth cues instead of
         reading as an empty void. Placed outside the +-1.5m voice-command
         waypoint envelope so they never occlude the flight itself. -->
    <geom name="ref_block_1" type="box" pos=" 8  8 1.0" size="0.6 0.6 1.0" material="prop_mat" contype="0" conaffinity="0"/>
    <geom name="ref_block_2" type="box" pos="-8  8 1.6" size="0.5 0.5 1.6" material="prop_mat" contype="0" conaffinity="0"/>
    <geom name="ref_block_3" type="box" pos=" 8 -8 0.7" size="0.7 0.7 0.7" material="prop_mat" contype="0" conaffinity="0"/>
    <geom name="ref_block_4" type="box" pos="-8 -8 1.3" size="0.55 0.55 1.3" material="prop_mat" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
